# Salin menjadi .env lalu isi nilainya.
SIMAN_BASE_URL=https://apigateway.kemenkeu.go.id
SIMAN_TOKEN_URL=https://sso.kemenkeu.go.id/connect/token
SIMAN_CLIENT_ID=
SIMAN_CLIENT_SECRET=
SIMAN_GRANT_TYPE=client_credentials
SIMAN_BA_KEY=
# SIMAN_DATA_DIR=data
# Kata sandi gerbang dasbor. Bila kosong, kata sandi acak dibuat sekali di
# data/auth.json. Semua data BMN hanya dapat diakses setelah masuk.
# DASBOR_PASSWORD=

# Asumsi analitik (opsional; dapat juga diubah di halaman Pengaturan).
# BMN_ESKALASI_HARGA=0.03      # eskalasi harga per tahun
# BMN_FAKTOR_REHAB=0.65        # biaya rehabilitasi berat sebagai porsi nilai bangunan
# BMN_SATUAN_UMUR_SISA=tahun   # satuan kolom umur_sisa: tahun | semester | bulan
